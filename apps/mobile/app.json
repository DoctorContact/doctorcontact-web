{
  "expo": {
    "name": "Dewasi Group",
    "slug": "dewasi-group",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dewasigroup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dewasigroup.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B3A8C"
      },
      "package": "com.dewasigroup.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3A8C",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
